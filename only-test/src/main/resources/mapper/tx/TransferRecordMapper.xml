<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wuyou.onlytest.tx.mapper.TransferRecordMapper">

    <select id="selectPageByAccountNo" resultType="com.wuyou.onlytest.tx.entity.TransferRecord">
        SELECT * FROM tx_transfer_record
        WHERE from_account_no = #{accountNo} OR to_account_no = #{accountNo}
        ORDER BY create_time DESC
    </select>

</mapper>
